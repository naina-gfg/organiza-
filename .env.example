# Ambiente de execucao (development | test | production)
NODE_ENV=development

# Porta HTTP local da aplicacao
PORT=3000

# Selecao explicita do banco de dados:
# - desenvolvimento local: sqlite (padrao quando DATABASE_URL nao esta definida) ou postgres
# - producao: postgres (obrigatorio; fallback silencioso para sqlite e bloqueado)
DB_CLIENT=sqlite

# Caminho opcional do arquivo SQLite local (padrao: backend/plataforma.db)
# SQLITE_DB_PATH=backend/plataforma.db

# String de conexao PostgreSQL de runtime usando role com privilegios minimos (ex.: organiza_app).
# Em producao com Supabase Transaction Pooler (Supavisor, porta 6543):
# DATABASE_URL=postgresql://organiza_app:REPLACE_WITH_STRONG_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Limites do Pool e timeouts para PostgreSQL (opcional)
# DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=15000

# Configuracao TLS para PostgreSQL (em hosts remotos/producao, TLS com validacao de certificado e ativo por padrao)
# DB_SSL=true
# DB_SSL_CA_FILE=
# DB_SSL_REJECT_UNAUTHORIZED=true

# Seguranca de sessoes, scrypt e rate limiting (opcional)
# Expiracao absoluta da sessao em segundos (padrao: 28800 = 8 horas)
# SESSION_TTL_SECONDS=28800
# SCRYPT_MAX_CONCURRENT=4
# SCRYPT_MAX_QUEUE=24
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_BLOCK_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
# RATE_LIMIT_REGISTER_MAX=10

# Proxy reverso confiavel: manter false localmente; em infraestrutura Vercel (PROD-03) configurar conforme numero de saltos
# TRUST_PROXY=false

# Conexao administrativa direta para execucao manual de migrations (NUNCA usar no runtime da aplicacao)
# DIRECT_URL=postgresql://postgres:REPLACE_WITH_ADMIN_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
