# Ambiente de execucao (development | test | production)
NODE_ENV=development

# Porta HTTP local da aplicacao (ignorada na Vercel Function)
PORT=3000

# Selecao explicita do banco de dados:
# - desenvolvimento local: sqlite (padrao quando DATABASE_URL nao esta definida) ou postgres
# - producao / Vercel: postgres (obrigatorio; fallback silencioso para sqlite e bloqueado)
DB_CLIENT=sqlite

# Caminho opcional do arquivo SQLite local (padrao: backend/plataforma.db)
# SQLITE_DB_PATH=backend/plataforma.db

# String de conexao PostgreSQL de runtime usando role com privilegios minimos (ex.: organiza_app).
# Em producao com Supabase Transaction Pooler (Supavisor, porta 6543) + SSL obrigatorio:
# Formato oficial do usuario no Supavisor: <ROLE>.<PROJECT_REF> (ex.: organiza_app.YOUR_PROJECT_REF)
# DATABASE_URL=postgresql://organiza_app.YOUR_PROJECT_REF:REPLACE_WITH_STRONG_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Limites do Pool e timeouts para PostgreSQL (opcional)
# DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=15000

# Configuracao TLS para PostgreSQL (em hosts remotos/producao, validacao estrita de certificado e obrigatoria)
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_CA_FILE=
# DB_SSL_REJECT_UNAUTHORIZED=true

# Seguranca de sessoes, scrypt (N=32768, r=8, p=3) e rate limiting (opcional)
# Expiracao absoluta da sessao em segundos (padrao: 28800 = 8 horas)
# SESSION_TTL_SECONDS=28800
# SCRYPT_MAX_CONCURRENT=4
# SCRYPT_MAX_QUEUE=16
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_BLOCK_MS=900000
# RATE_LIMIT_LOGIN_MAX=30
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
# RATE_LIMIT_REGISTER_MAX=20

# Configuracao segura de proxy (NUNCA usar true):
# - Localmente: false (padrao fora da Vercel; ignora X-Forwarded-For / X-Vercel-Forwarded-For)
# - Na Vercel (VERCEL=1): usa automaticamente o modo 'vercel' (trust proxy=1 + x-vercel-forwarded-for/x-real-ip)
# - Sob proxy proprio controlado: inteiro de 1 a 5 (ex.: TRUST_PROXY=1)
# TRUST_PROXY=false

# Conexao administrativa direta para execucao manual de migrations (NUNCA usar no runtime da aplicacao)
# DIRECT_URL=postgresql://postgres:REPLACE_WITH_ADMIN_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
